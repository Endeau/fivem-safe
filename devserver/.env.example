# Key from https://portal.cfx.re/servers/registration-keys
LICENSE_KEY=
# Any long random string
DB_PASSWORD=
# license:xxxx identifiers allowed to join, separated by spaces.
# Leave empty at first: the refused connection prints your identifier in the logs.
ALLOWED_IDENTIFIERS=
# Optional: Discord webhook that receives the safe_events alerts
DISCORD_WEBHOOK=
# Set to true only for a short two-player test from outside, then back to false.
OPEN=false
# Set to true to let a second client with the same Rockstar account join
# (police repro with FiveM -cl2); back to false after.
ESX_DEBUG=false
